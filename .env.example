# Copy to .env and fill in real values — never commit .env to git

# PostgreSQL connection string (same DB as registration_api)
DATABASE_URL=postgresql://batuta_app:PASSWORD@localhost:5432/batuta_downloads_trials

# Secret for JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Set to "true" when running behind HTTPS (production)
SECURE_COOKIES=false

# Max simultaneous Playwright jobs (each ~300MB RAM + Chromium)
MAX_CONCURRENT=4

# Parallel AJAX download workers per job
AJAX_WORKERS=4
